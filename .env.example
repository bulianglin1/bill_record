# Supabase Project Settings → API（仅作数据库与存储，不用 Auth 邮箱注册）
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 请在 SQL Editor 依次执行：
# 1) supabase/schema.sql         → users + vaults
# 2) supabase/transactions.sql   → 明文流水表
# 3) supabase/asset_snapshots.sql → 总资产日快照（登录/改资产时更新当天）
